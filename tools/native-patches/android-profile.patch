+// 密钥输入只传给上游派生实现，错误不能包含私钥。
+#[unsafe(no_mangle)]
+pub extern "system" fn Java_com_easytier_jni_EasyTierJNI_prepareSecureIdentity(
+    mut env: JNIEnv, _class: JClass, private_key: JString,
+) -> jstring {
+    use easytier::common::config::process_secure_mode_cfg;
+    use easytier::proto::common::SecureModeConfig;
+    let input: String = match env.get_string(&private_key) {
+        Ok(value) => value.into(),
+        Err(_) => { throw_exception(&mut env, "Invalid secure identity"); return ptr::null_mut(); }
+    };
+    let mode = SecureModeConfig { enabled: true, local_private_key: if input.is_empty() { None } else { Some(input) }, local_public_key: None };
+    let mode = match process_secure_mode_cfg(mode) {
+        Ok(value) => value,
+        Err(_) => { throw_exception(&mut env, "Invalid secure identity"); return ptr::null_mut(); }
+    };
+    let payload = serde_json::json!({"privateKey": mode.local_private_key, "publicKey": mode.local_public_key}).to_string();
+    match env.new_string(payload) {
+        Ok(value) => value.into_raw(),
+        Err(_) => { throw_exception(&mut env, "Could not create secure identity"); ptr::null_mut() }
+    }
+}
